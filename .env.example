DISCORD_TOKEN=put-your-bot-token-here
# BOT_TOKEN also works as an alias if you prefer that name.

# Optional but recommended while setting up. Guild commands appear immediately.
# Use your Discord server ID.
GUILD_ID=

# Keep this true if you want the newest yt-dlp every time the container starts.
UPDATE_YTDLP_ON_START=true

# Optional: use a cookies.txt export if YouTube starts requiring it.
# Put the file at ./cookies/youtube.cookies.txt
YTDLP_COOKIES_FILE=

LOG_LEVEL=INFO
